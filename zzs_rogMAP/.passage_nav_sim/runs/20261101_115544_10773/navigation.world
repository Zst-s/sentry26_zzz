    <model name="low_passage">
      <static>true</static>
      <pose>2.6 -2 0 0 0 0</pose>
      <link name="structure">
        <collision name="right">
          <pose>0 -0.7 0.325 0 0 0</pose>
          <geometry>
            <box>
              <size>1.2 .2 0.65</size>
