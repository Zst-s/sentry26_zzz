    </model>
    <model name="solid_wall">
      <static>true</static>
      <pose>2.6 4 .65 0 0 0</pose>
      <link name="structure">
        <collision name="wall">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.2 1.2 1.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.2 1.2 1.3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="sensor_rig">
      <static>false</static>
      <pose>0 0 .11 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <collision name="robot_body">
          <pose>-.01 0 .04 0 0 0</pose>
          <geometry>
            <box>
              <size>.62 .58 .30</size>
            </box>
          </geometry>
        </collision>
        <inertial>
          <mass>8</mass>
          <inertia>
            <ixx>0.46</ixx>
            <iyy>0.46</iyy>
            <izz>0.27</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="robot_body">
          <pose>-.01 0 .04 0 0 0</pose>
          <geometry>
            <box>
              <size>.62 .58 .30</size>
            </box>
          </geometry>
        </visual>
        <visual name="sensor">
          <geometry>
            <sphere>
              <radius>.05</radius>
            </sphere>
          </geometry>
        </visual>
        <sensor name="body_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact>
            <collision>robot_body</collision>
          </contact>
          <plugin name="contacts" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/passage_sim</namespace>
            </ros>
            <frame_name>base_link</frame_name>
          </plugin>
        </sensor>
      </link>
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/passage_sim</namespace>
          <remapping>cmd_vel:=drive_cmd_vel</remapping>
          <remapping>odom:=base_odom</remapping>
        </ros>
        <update_rate>50</update_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_rate>50</publish_rate>
        <odometry_frame>world</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
      </plugin>
      <plugin name="truth" filename="libgazebo_ros_p3d.so">
        <ros>
          <namespace>/passage_sim</namespace>
          <remapping>odom:=sensor_odom</remapping>
        </ros>
        <body_name>passage_lidar</body_name>
        <frame_name>world</frame_name>
        <update_rate>50</update_rate>
        <gaussian_noise>0</gaussian_noise>
      </plugin>
      <link name="passage_lidar">
        <pose>-0.32 0.0 0.066 -0.6109 0.0 1.5707963267948966</pose>
        <gravity>false</gravity>
        <sensor name="lidar" type="ray">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>8</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
              <vertical>
                <samples>48</samples>
                <resolution>1</resolution>
                <min_angle>-0.8</min_angle>
                <max_angle>0.8</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>8</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <plugin name="cloud" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/passage_sim</namespace>
              <remapping>~/out:=points</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud2</output_type>
            <frame_name>passage_lidar</frame_name>
          </plugin>
        </sensor>
      </link>
      <joint name="lidar_mount" type="fixed">
        <parent>base_link</parent>
        <child>passage_lidar</child>
      </joint>
    </model>
    <gui>
      <camera name="overview">
        <pose>-6 -7 7 0 .55 .65</pose>
      </camera>
    </gui>
  </world>
</sdf>