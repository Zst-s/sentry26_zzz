<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="passage_lab">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.2 0.22 0.25 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.3 0.1 -1</direction>
    </light>
    <plugin name="state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/passage_sim</namespace>
      </ros>
      <update_rate>20</update_rate>
    </plugin>
    <model name="ground">
